{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "{docs/**,a/**,app/**,assets/**,leaderboard/**,index.html,src/db/**,src/middleware/**,src/routes/**,src/services/**}"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.kairune.online" }],
      "destination": "https://kairune.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/docs", "destination": "/api/index.js" },
    { "source": "/docs/(.*)", "destination": "/api/index.js" },
    { "source": "/a", "destination": "/api/index.js" },
    { "source": "/a/(.*)", "destination": "/api/index.js" },
    { "source": "/leaderboard", "destination": "/api/index.js" },
    { "source": "/leaderboard/(.*)", "destination": "/api/index.js" }
  ]
}
